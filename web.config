<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS-Konfiguration für das Baustellentool
    =========================================
    Voraussetzungen:
      - IIS mit aktiviertem CGI-Modul (FastCGI)
      - PHP für Windows (NTS, x64) unter C:\PHP\
      - PHP als FastCGI-Handler in IIS registriert

    Anpassung PHP-Pfad:
      Falls PHP an einem anderen Ort installiert ist, den Pfad
      in <fastCgi> bzw. im Handler-Mapping entsprechend ändern.
-->
<configuration>

    <system.webServer>

        <!-- ================================================
             Standard-Dokument
             ================================================ -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!-- ================================================
             PHP FastCGI Handler-Mapping
             ================================================ -->
        <handlers>
            <remove name="PHP_via_FastCGI" />
            <add name="PHP_via_FastCGI"
                 path="*.php"
                 verb="GET,HEAD,POST"
                 modules="FastCgiModule"
                 scriptProcessor="C:\PHP\php-cgi.exe"
                 resourceType="Either"
                 requireAccess="Script" />
        </handlers>

        <!-- ================================================
             Sicherheit: sensible Verzeichnisse sperren
             ================================================ -->
        <security>
            <requestFiltering>
                <!-- Zugriff auf versteckte Dateien (.git, .env usw.) blockieren -->
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment=".env" />
                </hiddenSegments>
                <!-- Direkte Zugriffe auf PHP-Aktionsdateien (POST-only) einschränken -->
                <fileExtensions allowUnlisted="true">
                </fileExtensions>
            </requestFiltering>
        </security>

        <!-- ================================================
             Sicherheits-HTTP-Header
             ================================================ -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Frame-Options"        value="SAMEORIGIN" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-XSS-Protection"       value="1; mode=block" />
                <add name="Referrer-Policy"         value="strict-origin-when-cross-origin" />
            </customHeaders>
        </httpProtocol>

        <!-- ================================================
             Fehlerseiten (optional: eigene 404/500-Seite)
             ================================================ -->
        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="404" />
            <error statusCode="404"
                   path="/index.php"
                   responseMode="ExecuteURL" />
        </httpErrors>

        <!-- ================================================
             Statische Komprimierung
             ================================================ -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    </system.webServer>

    <!-- ================================================
         Zugriff auf config/-Verzeichnis komplett sperren
         (wird über eine separate web.config in config/ gesetzt)
         ================================================ -->

</configuration>
